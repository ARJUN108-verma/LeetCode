class Solution:
    def solve(self, board):
        if not board:
            return

        m, n = len(board), len(board[0])
        stack = []

        for i in range(m):
            if board[i][0] == 'O':
                stack.append((i, 0))
            if board[i][n - 1] == 'O':
                stack.append((i, n - 1))

        for j in range(n):
            if board[0][j] == 'O':
                stack.append((0, j))
            if board[m - 1][j] == 'O':
                stack.append((m - 1, j))

        while stack:
            r, c = stack.pop()
            if r < 0 or r >= m or c < 0 or c >= n or board[r][c] != 'O':
                continue
            board[r][c] = '#'
            stack.append((r + 1, c))
            stack.append((r - 1, c))
            stack.append((r, c + 1))
            stack.append((r, c - 1))

        for i in range(m):
            for j in range(n):
                if board[i][j] == 'O':
                    board[i][j] = 'X'
                elif board[i][j] == '#':
                    board[i][j] = 'O'
