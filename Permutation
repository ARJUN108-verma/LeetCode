class Solution:
    def permute(self, nums):
        result = []
        
        def backtrack(start):
            # If we've fixed all positions
            if start == len(nums):
                result.append(nums[:])  # make a copy
                return
            
            for i in range(start, len(nums)):
                # Swap current element with start
                nums[start], nums[i] = nums[i], nums[start]
                
                # Recurse for next position
                backtrack(start + 1)
                
                # Backtrack (restore original state)
                nums[start], nums[i] = nums[i], nums[start]
        
        backtrack(0)
        return result
