class Solution:
    def cloneGraph(self, node: 'Node') -> 'Node':
        if not node:
            return None

        visited = {}

        def dfs(curr):
            # If already cloned, return the clone
            if curr in visited:
                return visited[curr]

            # Create a clone of the current node
            clone = Node(curr.val)
            visited[curr] = clone

            # Clone all neighbors
            for neighbor in curr.neighbors:
                clone.neighbors.append(dfs(neighbor))

            return clone

        return dfs(node)
