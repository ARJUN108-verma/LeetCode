class Solution:
    def largestRectangleArea(self, heights):
        stack = []
        max_area = 0
        
        # Add a 0 height bar at the end
        heights.append(0)
        
        for i in range(len(heights)):
            # Maintain increasing stack
            while stack and heights[stack[-1]] > heights[i]:
                h = heights[stack.pop()]
                
                # Width calculation
                if stack:
                    width = i - stack[-1] - 1
                else:
                    width = i
                
                max_area = max(max_area, h * width)
            
            stack.append(i)
        
        return max_area
