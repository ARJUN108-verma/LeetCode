class Solution:
    def deleteDuplicates(self, head):
        dummy = ListNode(0)
        dummy.next = head
        
        prev = dummy
        curr = head
        
        while curr:
            # Check if current node is duplicate
            if curr.next and curr.val == curr.next.val:
                # Skip all nodes with same value
                while curr.next and curr.val == curr.next.val:
                    curr = curr.next
                
                # Remove duplicates
                prev.next = curr.next
            else:
                prev = prev.next
            
            curr = curr.next
        
        return dummy.next
        
