class Solution:
    def findSubstring(self, s, words):
        if not s or not words:
            return []
        
        word_len = len(words[0])
        word_count = len(words)
        total_len = word_len * word_count
        n = len(s)
        
        word_freq = Counter(words)
        result = []
        
        # Try different offsets
        for i in range(word_len):
            left = i
            current_count = 0
            window_freq = defaultdict(int)
            
            for right in range(i, n - word_len + 1, word_len):
                word = s[right:right + word_len]
                
                if word in word_freq:
                    window_freq[word] += 1
                    current_count += 1
                    
                    # If word appears too many times, shrink window
                    while window_freq[word] > word_freq[word]:
                        left_word = s[left:left + word_len]
                        window_freq[left_word] -= 1
                        left += word_len
                        current_count -= 1
                    
                    # If valid window found
                    if current_count == word_count:
                        result.append(left)
                        
                        left_word = s[left:left + word_len]
                        window_freq[left_word] -= 1
                        left += word_len
                        current_count -= 1
                else:
                    # Reset window
                    window_freq.clear()
                    current_count = 0
                    left = right + word_len
        
        return result
