
class Solution:
    def countPrimes(self, n: int) -> int:
        if n < 3:
            return 0

        sieve = bytearray(b'\x01') * n
        sieve[0] = sieve[1] = 0

        for i in range(2, int(n ** 0.5) + 1):
            if sieve[i]:
                start = i * i
                sieve[start:n:i] = b'\x00' * ((n - 1 - start) // i + 1)

        return sum(sieve)
