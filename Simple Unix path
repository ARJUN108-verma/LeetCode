class Solution:
    def simplifyPath(self, path):
        stack = []
        curr = ""
        
        for ch in path + "/":
            if ch == "/":
                if curr == "..":
                    if stack:
                        stack.pop()
                elif curr != "" and curr != ".":
                    stack.append(curr)
                curr = ""
            else:
                curr += ch
        
        result = ""
        for dir in stack:
            result += "/" + dir
        
        return result if result else "/"
