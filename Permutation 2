class Solution:
    def permuteUnique(self, nums):
        def backtrack(path):
            if len(path) == len(nums):
                result.append(path[:])
                return
            
            for i in range(len(nums)):
                # Skip already used elements
                if used[i]:
                    continue
                
                # Skip duplicates
                if i > 0 and nums[i] == nums[i - 1] and not used[i - 1]:
                    continue
                
                # Choose
                used[i] = True
                path.append(nums[i])
                
                # Explore
                backtrack(path)
                
                # Backtrack
                path.pop()
                used[i] = False
        
        nums.sort()
        result = []
        used = [False] * len(nums)
        backtrack([])
        
        return result
