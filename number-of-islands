class Solution:
    def numIslands(self, grid):
        m, n = len(grid), len(grid[0])
        count = 0

        for i in range(m):
            for j in range(n):
                if grid[i][j] == '1':
                    count += 1
                    grid[i][j] = '0'
                    stack = [(i, j)]

                    while stack:
                        r, c = stack.pop()

                        if r > 0 and grid[r - 1][c] == '1':
                            grid[r - 1][c] = '0'
                            stack.append((r - 1, c))

                        if r + 1 < m and grid[r + 1][c] == '1':
                            grid[r + 1][c] = '0'
                            stack.append((r + 1, c))

                        if c > 0 and grid[r][c - 1] == '1':
                            grid[r][c - 1] = '0'
                            stack.append((r, c - 1))

                        if c + 1 < n and grid[r][c + 1] == '1':
                            grid[r][c + 1] = '0'
                            stack.append((r, c + 1))

        return count
