class Solution:
    def searchRange(self, nums, target):
        n = len(nums)
        
        # Find left boundary (lower bound)
        left, right = 0, n
        while left < right:
            mid = (left + right) // 2
            if nums[mid] < target:
                left = mid + 1
            else:
                right = mid
        first = left
        
        # If target not found
        if first == n or nums[first] != target:
            return [-1, -1]
        
        # Find right boundary (upper bound)
        left, right = 0, n
        while left < right:
            mid = (left + right) // 2
            if nums[mid] <= target:
                left = mid + 1
            else:
                right = mid
        last = left - 1
        
        return [first, last]
