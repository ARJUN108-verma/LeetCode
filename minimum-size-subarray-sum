class Solution:
    def minSubArrayLen(self, target: int, nums: list[int]) -> int:
        left = 0
        total = 0
        ans = len(nums) + 1

        for right, num in enumerate(nums):
            total += num

            while total >= target:
                ans = min(ans, right - left + 1)
                total -= nums[left]
                left += 1

        return ans if ans <= len(nums) else 0
