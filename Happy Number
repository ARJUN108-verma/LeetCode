
class Solution:
    def isHappy(self, n: int) -> bool:
        def nxt(x):
            s = 0
            while x:
                x, d = divmod(x, 10)
                s += d * d
            return s

        slow = n
        fast = nxt(n)

        while fast != 1 and slow != fast:
            slow = nxt(slow)
            fast = nxt(nxt(fast))

        return fast == 1
