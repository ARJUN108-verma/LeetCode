class Solution:
    def maxPathSum(self, root):
        ans = [-1000000000]

        def dfs(node):
            if node is None:
                return 0

            left = dfs(node.left)
            if left < 0:
                left = 0

            right = dfs(node.right)
            if right < 0:
                right = 0

            cur = node.val + left + right
            if cur > ans[0]:
                ans[0] = cur

            if left > right:
                return node.val + left
            return node.val + right

        dfs(root)
        return ans[0]
