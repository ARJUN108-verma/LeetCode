class Solution:
    def numDistinct(self, s, t):
        m, n = len(s), len(t)

        if n > m:
            return 0

        dp = [1] + [0] * n
        tt = t

        for i in range(m):
            si = s[i]
            for j in range(min(i + 1, n) - 1, -1, -1):
                if si == tt[j]:
                    dp[j + 1] += dp[j]

        return dp[n]
